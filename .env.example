# New installations: ./scripts/init-env.sh creates this file as .env, mode 600.
# Existing installation: preserve database credentials; never overwrite .env.
# Secrets must stay private. These values are placeholders, not working accounts.
ORACLE_SYS_PASSWORD=replace-with-a-generated-secret
ORACLE_APP_USER=NEXUS_APP
ORACLE_APP_PASSWORD=replace-with-a-different-generated-secret
ORACLE_JDBC_URL=jdbc:oracle:thin:@127.0.0.1:1521/FREEPDB1
NEXUS_SETUP_TOKEN=replace-with-a-generated-setup-token

# Host development; do not export SERVER_ADDRESS=0.0.0.0 on a public interface.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
NEXUS_FRONTEND_URL=http://127.0.0.1:4200
NEXUS_COOKIE_SECURE=false
NEXUS_SESSION_TIMEOUT=30m
NEXUS_RESET_MINUTES=30
NEXUS_STORAGE_DIR=../var/attachments
NEXUS_AUDIT_RETENTION_DAYS=365
NEXUS_NOTIFICATION_RETENTION_DAYS=90
NEXUS_API_DOCS_ENABLED=true

# Mailpit for local development; real SMTP requires credentials and STARTTLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@nexus.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Full-stack containers use internal DNS instead of localhost.
NEXUS_DEPLOY_FRONTEND_URL=http://127.0.0.1:8081
NEXUS_DEPLOY_SMTP_HOST=mailpit
